# Copy to .env and fill in. Never commit the real .env.

# Required: your Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Optional overrides
BOT_USERNAME=@tallukkabot

# Optional Claude API for persona-based replies (primary). Leave empty to
# skip straight to the local LLM / hardcoded fallback below.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Optional local LLM fallback (Ollama), used if Claude is unavailable.
# Leave USE_LLM=false to disable.
USE_LLM=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional daily scheduled message
# DAILY_CHAT_ID=
# DAILY_TIME=12:00
